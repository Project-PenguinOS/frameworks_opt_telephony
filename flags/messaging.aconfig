}

# OWNER=prajogo TARGET=26Q2
flag {
  name: "redact_generic_otp_sms"
  namespace: "telephony"
  description: "Redact Generic OTP SMS messages from untrusted packages"
  bug: "437043173"
}

# OWNER=jferec TARGET=26Q2
flag {
  name: "secure_access_to_restricted_rcs_messages"
  namespace: "telephony"
  description: "Introduces access restrictions to reading and writing restricted RCS messages in the messaging database."
  bug: "459576374"
  is_exported: true
}

# OWNER=paulsoumyadeep TARGET=26q2
flag {
 name: "cache_sms_application_data"
 namespace: "telephony"
 description: "Caches the result of getApplicationCollectionInternal to reduce PackageManager queries."
 bug: "350569741"
 metadata {
     purpose: PURPOSE_BUGFIX
 }
}

# OWNER=braydenhass TARGET=26Q2
flag {
    name: "sms_network_security_events"
    namespace: "telephony"
    description: "Guard system API for SMS network security events."
    bug: "407790397"
    metadata {
        purpose: PURPOSE_FEATURE
    }
}

# OWNER=nishantpanwar TARGET=26Q2
