package: "com.android.internal.telephony.flags"
container: "system"

# OWNER=tnd TARGET=24Q3
flag {
  name: "mms_disabled_error"
  is_exported: true
  namespace: "telephony"
  description: "This flag controls the support of the new MMS error code MMS_ERROR_MMS_DISABLED."
  bug: "305062594"
}

# OWNER=ntmyren TARGET=25Q4
flag {
  name: "redact_otp_sms"
  namespace: "telephony"
  description: "Redact OTP SMS messages from untrusted listeners"
  bug: "351976749"
}

# OWNER=ntmyren TARGET=25Q4
flag {
  name: "redact_otp_sms_api"
  is_exported: true
  namespace: "telephony"
  description: "API flag for redacting OTP SMS messages from untrusted listeners"
  bug: "351976749"
}

# OWNER=ntmyren TARGET=25Q4
flag {
  name: "limit_raw_table_visibility"
  namespace: "telephony"
  description: "limits the visibility of the raw SMS table"
  bug: "430572311"
  metadata {
      purpose: PURPOSE_BUGFIX
  }
}

# OWNER=nykkumar TARGET=25Q2
flag {
  name: "sms_mms_deliver_broadcasts_redirect_to_main_user"
  namespace: "telephony"
  description: "This flag controls the redirection of SMS_DELIVER AND WAP_PUSH_DELIVER broadcasts to the MAIN user."
  bug: "314321617"
}

# OWNER=prajogo TARGET=26Q2
flag {
  name: "redact_webotp_sms"
  namespace: "telephony"
  description: "Redact WebOTP SMS messages from untrusted packages"
  bug: "437043173"
}

# OWNER=prajogo TARGET=26Q2
flag {
  name: "redact_generic_otp_sms"
  namespace: "telephony"
  description: "Redact Generic OTP SMS messages from untrusted packages"
  bug: "437043173"
}

# OWNER=jferec TARGET=25Q4
flag {
  name: "secure_access_to_restricted_rcs_messages"
  namespace: "telephony"
  description: "Introduces access restrictions to reading and writing secure RCS messages in the messaging database."
  bug: "462173073"
}

